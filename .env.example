# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WHATSAPP_TOKEN: Meta Cloud API System User or Temporary Access Token
# Generated from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_TOKEN="EAA..."

# WHATSAPP_PHONE_NUMBER_ID: Meta Phone Number ID from API Setup
WHATSAPP_PHONE_NUMBER_ID="100609349999999"

# WHATSAPP_VERIFY_TOKEN: Custom secret string you define to verify webhook with Meta
# e.g., chatbuddy_secure_verify_token_2026
WHATSAPP_VERIFY_TOKEN="chatbuddy_secure_verify_token_2026"

# WHATSAPP_APP_SECRET: Meta App Secret (from App settings -> Basic) used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# OWNER_PHONE: WhatsApp number of the business owner for alerts and escalations (with country code, e.g., +15551234567)
OWNER_PHONE="+15551234567"

# SESSION_SECRET: Secret for signing sessions and tokens
SESSION_SECRET="chatbuddy_session_secret_key_change_in_prod"

# APP_URL: The public URL where this app is hosted (or your ngrok URL for webhook testing)
APP_URL="https://your-domain.com"
